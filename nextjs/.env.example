# Odoo backend. Staging is the right default for development; the deployed
# frontend points at production, so this is not a value to copy between
# environments without looking. See E2E_WRITABLE_HOSTS at the foot of this file
# for what the test scripts are allowed to write to.
ODOO_BASE_URL=https://async-school-staging.onrender.com
ODOO_DB=neondb

# Signs this application's own session cookie. Unrelated to any Odoo secret.
# Generate with:  openssl rand -base64 32
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# Staging sleeps on Render's free plan; the first request can take ~1 minute.
ODOO_TIMEOUT_MS=60000

# Only for a local run over plain http (next start forces NODE_ENV=production).
# Never set this in a deployed environment.
# SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Which Odoo the test scripts may WRITE to.
#
# Nothing needs to be set to work locally: localhost and 127.0.0.1 are always
# writable, and everything else is refused. This variable exists only to write
# to a shared database on purpose, and it is the one lever that does it —
# E2E_ALLOW_WRITES states a suite's intent and cannot approve a destination.
#
# Exact hostnames, comma separated. No wildcards; a subdomain of a named host
# is not the named host. Never put a production host here.
#
# E2E_WRITABLE_HOSTS=async-school-staging.onrender.com
