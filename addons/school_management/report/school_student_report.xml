<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_school_student" model="ir.actions.report">
        <field name="name">Student Report</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.report_school_student_document</field>
        <field name="report_file">school_management.report_school_student_document</field>
        <field name="print_report_name">'Student Report - %s' % object.name</field>
        <field name="binding_model_id" ref="model_school_student"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_school_student_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="student">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Student Report</h2>
                        <h3>
                            <span t-field="student.name"/>
                            — Reg. No: <span t-field="student.regno"/>
                        </h3>

                        <h4>Identity</h4>
                        <table class="table table-sm">
                            <tr><td><strong>Date of Birth</strong></td><td><span t-field="student.date_of_birth"/></td></tr>
                            <tr><td><strong>Age</strong></td><td><span t-field="student.age"/></td></tr>
                            <tr><td><strong>Gender</strong></td><td><span t-field="student.gender"/></td></tr>
                            <tr><td><strong>Nationality</strong></td><td><span t-field="student.nationality_id"/></td></tr>
                            <tr><td><strong>Education Level</strong></td><td><span t-field="student.education_level"/></td></tr>
                            <tr><td><strong>Admission Type</strong></td><td><span t-field="student.admission_type"/></td></tr>
                            <tr><td><strong>National ID</strong></td><td><span t-field="student.national_id"/></td></tr>
                            <tr><td><strong>FAN (National ID)</strong></td><td><span t-field="student.fan_number"/></td></tr>
                            <tr><td><strong>Regional ID</strong></td><td><span t-field="student.regional_id"/></td></tr>
                        </table>

                        <h4>Placement</h4>
                        <table class="table table-sm">
                            <tr><td><strong>Class / Grade</strong></td><td><span t-field="student.class_id"/></td></tr>
                            <tr><td><strong>Academic Year</strong></td><td><span t-field="student.academic_year_id"/></td></tr>
                            <tr><td><strong>Section</strong></td><td><span t-field="student.section_id"/></td></tr>
                            <tr><td><strong>Registration Status</strong></td><td><span t-field="student.registration_status"/></td></tr>
                        </table>

                        <h4>Parent / Guardian</h4>
                        <table class="table table-sm">
                            <tr><td><strong>Name</strong></td><td><span t-field="student.guardian_name"/></td></tr>
                            <tr><td><strong>Phone</strong></td><td><span t-field="student.guardian_phone"/></td></tr>
                            <tr><td><strong>Address</strong></td><td><span t-field="student.address"/></td></tr>
                            <tr><td><strong>Previous School</strong></td><td><span t-field="student.previous_school"/></td></tr>
                        </table>

                        <h4>Emergency Contact</h4>
                        <table class="table table-sm">
                            <tr><td><strong>Name</strong></td><td><span t-field="student.emergency_contact_name"/></td></tr>
                            <tr><td><strong>Phone</strong></td><td><span t-field="student.emergency_contact_phone"/></td></tr>
                        </table>

                        <h4>Enrollment History</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Academic Year</th><th>Class</th><th>Roll No.</th><th>State</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="student.enrollment_ids" t-as="enrollment">
                                    <tr>
                                        <td><span t-field="enrollment.academic_year_id"/></td>
                                        <td><span t-field="enrollment.class_id"/></td>
                                        <td><span t-field="enrollment.roll_number"/></td>
                                        <td><span t-field="enrollment.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
